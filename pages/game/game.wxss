/* pages/game/game.wxss */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx;
  background: #1a1a2e;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  width: 100%;
  justify-content: space-around;
  margin-bottom: 16rpx;
}

.stat {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #fff;
}

.label {
  font-size: 22rpx;
  color: #9aa0c0;
  margin-bottom: 4rpx;
}

.value {
  font-size: 40rpx;
  font-weight: bold;
  color: #00e5ff;
}

.value.hi {
  color: #ffd600;
}

.game-area {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.game-canvas {
  background: #0f0f23;
  border: 2rpx solid #2a2a4a;
  border-radius: 8rpx;
}

.side {
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.next-label {
  color: #9aa0c0;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.next-canvas {
  background: #1a1a3a;
  border: 2rpx solid #2a2a4a;
  border-radius: 8rpx;
}

.tip {
  margin-top: 16rpx;
  color: #6b7099;
  font-size: 20rpx;
  line-height: 1.5;
  text-align: center;
  white-space: pre-line;
}

.controls {
  margin-top: 28rpx;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-row {
  display: flex;
  margin-bottom: 16rpx;
}

.btn {
  width: 130rpx;
  height: 96rpx;
  margin: 0 10rpx;
  background: #16213e;
  color: #fff;
  border-radius: 12rpx;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #2a2a4a;
  user-select: none;
}

.btn:active {
  background: #0f3460;
}

.btn.wide {
  width: 280rpx;
  font-size: 32rpx;
}

.btn.drop {
  background: #e94560;
}

.btn.drop:active {
  background: #c5304a;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.75);
  display: flex;
  align-items: center;
  justify-content: center;
}

.overlay-box {
  background: #16213e;
  padding: 60rpx 70rpx;
  border-radius: 20rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #2a2a4a;
}

.over-title {
  color: #e94560;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 24rpx;
}

.over-score {
  color: #fff;
  font-size: 36rpx;
  margin-bottom: 12rpx;
}

.over-best {
  color: #ffd600;
  font-size: 28rpx;
  margin-bottom: 36rpx;
}

.restart-btn {
  width: 300rpx;
  height: 90rpx;
  background: #00e5ff;
  color: #0f0f23;
  font-size: 34rpx;
  font-weight: bold;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
